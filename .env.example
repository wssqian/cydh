# Server listen port. The application and Linux deployment default to 80 when unset.
PORT=1234

# Persistent SQLite directory. Keep it outside application release directories in production.
NAV_DATA_DIR=./data

# Administrator password for /wssqianadmin. Change this value before exposing a server.
ADMIN_PASSWORD=WSSqian：

# Maximum time an upstream scraper request may block a scraper job.
SCRAPER_TIMEOUT_MS=15000

# Maximum bytes accepted for one scraper HTML page response.
SCRAPER_MAX_HTML_BYTES=3145728

# Icon download concurrency and maximum bytes per cached icon.
SCRAPER_ICON_CONCURRENCY=2
SCRAPER_MAX_ICON_BYTES=2097152

# Additional retry count per scraper page when an upstream request fails.
SCRAPER_RETRY_COUNT=1

# Minimum interval between scraper jobs, including manual triggers and scheduled runs.
SCRAPER_MIN_INTERVAL_MS=300000

# Optional scraper source override. Defaults to https://www.acgbox.link/.
SCRAPER_URL=

# Optional HTTP/HTTPS proxy override for scraper requests.
SCRAPER_PROXY_URL=

# Optional ACG API proxy. Supports a traditional HTTP proxy or a Worker reverse proxy URL.
# Worker URL (e.g. https://your-worker.workers.dev) is RECOMMENDED: it serves both ACG API
# proxying AND as the edge source for Pixiv image loading/download, so the browser fetches
# Worker/CF CDN directly and your server forwards 0 image bytes.
# Leave ACG_PROXY_URL empty to manage this in /wssqianadmin; with proxy enabled there,
# an empty admin URL lets the server read the current system proxy without changing it.
# Set ACG_PROXY_ENABLED=false to ignore ACG_PROXY_URL without editing the value.
ACG_PROXY_URL=
# Example: ACG_PROXY_URL=https://dawn-smoke-e638.wssqian.workers.dev
ACG_PROXY_ENABLED=

# Optional ACG upstream tokens. Do not commit real values.
BANGUMI_ACCESS_TOKEN=
VNDB_API_TOKEN=

# Optional Pixiv image fallback Worker base URL. Empty means no built-in image Worker fallback.
PIXIV_IMAGE_PROXY_BASE=

# Email notification settings using Resend API (also configurable via admin UI)
# Get your API key at https://resend.com/api-keys
# RESEND_API_KEY=re_...
# EMAIL_FROM_ADDR=onboarding@resend.dev
# EMAIL_FROM_NAME=次元导航
# EMAIL_ADMIN_RECIPIENTS=admin@example.com


# Minimum parsed resources required for a successful scraper health check.
SCRAPER_MIN_RESOURCES=10

# Maximum in-process memory used for serialized public catalog response cache.
PUBLIC_CATALOG_CACHE_MAX_BYTES=4194304

# --- Updater / release repository ---
# 开发仓库 wssqian/guga- 仅作代码备份；公开发布仓库 wssqian/cydh 承载签名产物供更新系统拉取。
# 默认使用公开仓库 wssqian/cydh（公开无需 token）。若要用私有仓库作更新源，设置只读 token。
GITHUB_OWNER=wssqian
GITHUB_REPO=cydh
# GITHUB_TOKEN=ghp_xxx   # 仅私有仓库读取 Release 需要

# --- Data export / import bundle ---
# 数据 bundle（.tar.gz）默认导出到 <项目>/data-export/；备份目录在数据目录同级 backups/。
# NAV_DATA_DIR 已用于定位运行时数据；导出/导入遵循该目录。
