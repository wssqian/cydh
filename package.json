{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/check-scraper.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/check-scraper.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:acgbox": "tsx scripts/test-acgbox-scraper.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "data:export": "tsx scripts/export-data.ts",
    "data:import": "tsx scripts/import-data.ts",
    "scraper:check": "tsx scripts/check-scraper.ts",
    "updater:gen-keys": "tsx scripts/generate-updater-keys.ts",
    "updater:sign": "tsx scripts/sign-updater-dist.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "semver": "^7.6.3",
    "tweetnacl": "^1.0.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2",
    "ip-address": "^10.3.1",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.17"
  }
}
